[gd_scene format=3]

[sub_resource type="GDScript" id="GDScript_stage_clear"]
script/source = "extends CanvasLayer

func _ready() -> void:
	var panel := $BannerPanel
	panel.modulate.a = 0.0
	var tween := create_tween()
	tween.tween_property(panel, \"modulate:a\", 1.0, 0.35)
	tween.tween_interval(3.0)
	tween.tween_property(panel, \"modulate:a\", 0.0, 0.6)
	await tween.finished
	queue_free()
"

[node name="StageClearUI" type="CanvasLayer"]
script = SubResource("GDScript_stage_clear")

